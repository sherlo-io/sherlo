{
  "name": "@sherlo/root",
  "private": true,
  "description": "Sherlo: Visual testing for React Native",
  "keywords": [
    "visual testing",
    "visual regression testing",
    "react native",
    "react native visual testing",
    "ios",
    "android",
    "simulators",
    "screenshot testing",
    "ui"
  ],
  "homepage": "https://sherlo.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/sherlo-io/sherlo.git"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "lerna run build",
    "repo": "node scripts/repo.mjs",
    "lint": "oxlint packages/cli/src packages/react-native-storybook/src && yarn format:check",
    "format:check": "prettier --check 'packages/cli/src/**/*.{ts,tsx}' 'packages/react-native-storybook/src/**/*.{ts,tsx}'",
    "lint:circular-dependencies": "npx madge --extensions ts --circular .",
    "lint:js": "oxlint --report-unused-disable-directives",
    "lint:js:fix": "oxlint --fix --report-unused-disable-directives",
    "lint:types": "tsc --noEmit",
    "typecheck": "tsc --noEmit -p packages/cli && tsc --noEmit -p packages/react-native-storybook && tsc --noEmit -p contracts",
    "reset": "./scripts/reset.sh",
    "pack:testing-apps": "bash ./scripts/pack-testing-apps.sh",
    "switch-env:test": "./scripts/switch-env.sh test",
    "switch-env:dev": "./scripts/switch-env.sh dev",
    "switch-env:prod": "./scripts/switch-env.sh prod"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "lerna": "^9.0.3",
    "oxlint": "1.88.0",
    "prettier": "2.8.8",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=10.24.1",
    "yarn": ">=4.3.1"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "tar": ">=7.5.10",
    "typescript": "7.0.2"
  }
}
