// THE LAW'S OWN TYPECHECK. packages/cli/tsconfig.json includes only `src`, so nothing in CI ever
// compiled ./pose.contract.law.ts - and a law nobody runs pins nothing. This project compiles it,
// and pr_checks.yml runs this project. The options mirror the CLI's, because the law reaches
// straight into the CLI's own sources.
{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["."]
}
