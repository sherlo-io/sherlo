{
  "name": "sherlo",
  "version": "3.0.0-alpha.0",
  "description": "Visual regression testing for React Native - Sherlo CLI",
  "keywords": [
    "react-native",
    "storybook",
    "expo",
    "eas",
    "ios",
    "android",
    "cli",
    "visual-testing",
    "visual-regression-testing",
    "screenshot-testing",
    "ui-testing"
  ],
  "license": "MIT",
  "author": "Sherlo",
  "homepage": "https://sherlo.io",
  "bugs": {
    "url": "https://github.com/sherlo-io/sherlo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sherlo-io/sherlo.git",
    "directory": "packages/cli"
  },
  "main": "dist/index.js",
  "types": "dist/cli/src/index.d.ts",
  "bin": "./cli.js",
  "files": [
    "dist",
    "sdk-compatibility.json",
    "cli.js"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --minify --keep-names --sourcemap --external:@expo/fingerprint --external:@napi-rs/keyring --outfile=dist/index.js && tsc --emitDeclarationOnly && chmod u+x ./dist/index.js",
    "check:packed-fingerprint": "node scripts/check-packed-fingerprint.js",
    "check:pose-contract": "yarn run -T tsx scripts/generate-pose-contract.ts --check",
    "generate:pose-contract": "yarn run -T tsx scripts/generate-pose-contract.ts",
    "lint": "cd ../.. && yarn run -T oxlint packages/cli/src actions/lib && cd packages/cli && yarn run -T prettier --check 'src/**/*.{ts,tsx}' '../../actions/lib/**/*.mjs'",
    "test": "../../scripts/require-test-exec-optin.sh && vitest run"
  },
  "dependencies": {
    "@expo/fingerprint": "^0.11.0",
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/types": "^7.29.0",
    "@inquirer/core": "^10.3.2",
    "@inquirer/prompts": "^7.8.4",
    "@sentry/node": "10.47.0",
    "@sherlo-io/time-limits": "0.0.0-tsf-spike.1",
    "@sherlo/api-types": "portal:../../sherlo-lib/extracted/@sherlo/api-types",
    "@sherlo/common-client": "portal:../../sherlo-lib/extracted/@sherlo/common-client",
    "@sherlo/sdk-client": "portal:../../sherlo-lib/extracted/@sherlo/sdk-client",
    "@sherlo/shared": "portal:../../sherlo-lib/extracted/@sherlo/shared",
    "@types/git-rev-sync": "^2.0.0",
    "@types/gradient-string": "^1.1.2",
    "@types/node": "^16.11.7",
    "@types/node-fetch": "^2.6.4",
    "@types/prompts": "^2.4.9",
    "@types/tar": "^6.1.5",
    "@types/ws": "^8.5.14",
    "ansi-escapes": "^7.2.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "esbuild": "^0.25.0",
    "fast-glob": "^3.3.3",
    "find-up": "^7.0.0",
    "gradient-string": "^2.0.1",
    "graphql": "^16.6.0",
    "js-yaml": "^4.1.0",
    "magicast": "^0.5.2",
    "node-fetch": "^2.6.11",
    "ora": "^8.2.0",
    "package-manager-detector": "^0.2.9",
    "type-fest": "^4.20.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.4",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
